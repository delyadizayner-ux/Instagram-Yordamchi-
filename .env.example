# === Supabase (Settings → API) ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Token shifrlash uchun 32 baytli (64 hex belgi) maxfiy kalit ===
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# === Instagram / Meta webhook ===
# O'zingiz o'ylab topgan istalgan maxfiy so'z (Meta App webhook sozlamasida ham xuddi shu qiymat kiritiladi)
IG_WEBHOOK_VERIFY_TOKEN=

# Meta App → Settings → Basic → App Secret (webhook imzosini tekshirish uchun, ixtiyoriy lekin tavsiya etiladi)
META_APP_SECRET=

# === Cron endpointlarni tashqi chaqiruvdan himoyalash uchun ===
# Yaratish: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# === AI Strateg (Google AI Studio / Gemini) ===
# https://aistudio.google.com/apikey dan bepul olinadi
GEMINI_API_KEY=
